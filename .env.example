# Reseau: base-sepolia (test, defaut) ou base (production)
NETWORK=base-sepolia

# URL publique de CE serveur, telle qu'annoncee aux agents (Bazaar/decouverte,
# .well-known/x402.json). JAMAIS localhost en production : mets l'URL Render
# (ou ton domaine). Sans slash final.
BASE_URL=https://x402-seller.onrender.com

# Adresse EVM qui recoit les paiements USDC
PAY_TO_ADDRESS=0x5c3DB195a38f39074d8c891741A82f6D8f2A16Cc

# Cles CDP (Coinbase Developer Platform) — requises UNIQUEMENT si NETWORK=base
# https://portal.cdp.coinbase.com -> API keys (Secret API Key)
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Cle privee du portefeuille ACHETEUR de test (generee par: npm run generate-buyer-wallet)
BUYER_PRIVATE_KEY=

# Cle API Anthropic (pour de futurs endpoints IA payants)
ANTHROPIC_API_KEY=

# Gamme "premium reseller" (voir README) — cles prepayees/pay-as-you-go,
# AUCUN abonnement. Chaque endpoint renvoie un 503 propre (jamais 500) tant
# que sa cle n'est pas fournie.
# Tavily (recherche web + extraction de page) — https://tavily.com/pricing
TAVILY_API_KEY=
# Serper.dev (resultats Google structures) — https://serper.dev
SERPER_API_KEY=

# Port du serveur
PORT=4021

# Repertoire des journaux (paiements.jsonl, sondages.jsonl). Defaut "./logs"
# en local. Sur Render, DOIT pointer vers le point de montage d'un disque
# persistant (ex: /var/data) — sinon ces journaux sont perdus a chaque
# redeploiement (disque ephemere par defaut).
DATA_DIR=./logs

# Cle API Render (deploiement via l'API REST Render, jamais commitee)
# https://dashboard.render.com/settings/api-keys
RENDER_API_KEY=

# Token GitHub optionnel (releve le plafond 60->5000 req/h sur GET /api/github/repo,
# aucun scope requis, donnees de depots publics uniquement)
GITHUB_TOKEN=

# Cle secrete protegeant GET /stats/daily (revenu detaille, payers) — genere une
# valeur aleatoire, ex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STATS_KEY=

# n8n (pour le workflow "x402 - rapport quotidien") — URL de ton instance et
# une cle API n8n (Settings -> n8n API dans n8n)
N8N_URL=
N8N_API_KEY=
